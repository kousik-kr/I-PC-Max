{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pace.example/schemas/result_record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "system", "dataset", "query", "configuration", "status", "timing_ns", "memory_bytes", "counters", "output", "quality", "error"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "run": {"$ref": "#/$defs/run"},
    "system": {"$ref": "#/$defs/system"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "query": {"$ref": "#/$defs/query"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "status": {"type": "object"},
    "timing_ns": {"$ref": "#/$defs/timing"},
    "memory_bytes": {"$ref": "#/$defs/memory"},
    "counters": {"$ref": "#/$defs/counters"},
    "output": {"$ref": "#/$defs/output"},
    "quality": {"$ref": "#/$defs/quality"},
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"status": {"$ref": "#/$defs/statusV1"}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"properties": {"status": {"$ref": "#/$defs/statusV2"}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {"properties": {"status": {"$ref": "#/$defs/statusV3"}}}
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_id", "experiment_name", "timestamp_utc", "repetition", "warmup", "git_commit", "git_dirty", "executable_version", "build_type", "command_line", "config_hash"]
    },
    "system": {
      "type": "object",
      "required": ["hostname", "operating_system", "kernel", "cpu_model", "physical_cores", "logical_cores", "total_memory_bytes", "compiler", "compiler_version", "runtime_version", "thread_count", "process_id"]
    },
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "dataset_path", "graph_checksum", "vertices", "edges", "parallel_edges", "average_out_degree", "maximum_out_degree", "temporal_horizon_start", "temporal_horizon_end", "travel_time_piece_count", "score_piece_count", "average_travel_time_pieces_per_edge", "average_score_pieces_per_edge", "anchor_count", "anchor_density", "zero_score_edge_fraction", "topology_seed", "temporal_seed", "score_seed"]
    },
    "query": {
      "type": "object",
      "required": ["query_id", "source", "destination", "interval_start", "interval_end", "window_length", "budget", "budget_slack", "budget_policy", "distance_bin", "lower_bound_distance", "fastest_travel_time_min", "fastest_travel_time_max", "query_seed"]
    },
    "configuration": {
      "type": "object",
      "required": ["algorithm", "ablation", "execution_mode", "preprocessing_accounting", "theta", "anchor_limit", "k", "pace_engine", "pivot_limit_l", "connector_limit_kc", "frontier_limit_kf", "connector_expansion_cap_mc", "breakpoint_cap_mb", "query_work_cap_mq", "rpq_step_minutes", "baseline_k", "threads", "deterministic", "timeout_seconds", "memory_limit_bytes", "max_enumerated_paths", "max_labels", "max_expansions", "max_frontier_fragments", "anchor_decomposition_enabled", "safe_dominance_enabled", "memoization_enabled", "per_cell_retention_enabled", "representative_retention_enabled", "anchor_lower_bound_filter_enabled", "compression_enabled", "adjacent_merge_enabled", "safe_corridor_enabled", "pivot_diversification_enabled", "connector_portfolio_enabled", "connector_cache_enabled", "profile_cache_enabled", "score_upper_bound_enabled", "parallel_enabled", "exhaustive_connectors", "exhaustive_anchors", "exhaustive_frontier"]
    },
    "statusV1": {
      "type": "object",
      "required": ["status_code", "completed", "reference_available", "output_verified", "exit_code"],
      "properties": {
        "status_code": {"enum": ["COMPLETED", "NO_FEASIBLE_PATH", "TIMEOUT", "OUT_OF_MEMORY", "LIMIT_EXCEEDED", "FUNCTION_HORIZON_EXCEEDED", "INVALID_QUERY", "INVALID_CONFIGURATION", "ERROR"]},
        "completed": {"type": "boolean"},
        "reference_available": {"type": "boolean"},
        "output_verified": {"type": "boolean"},
        "exit_code": {"type": "integer"}
      }
    },
    "statusV2": {
      "type": "object",
      "required": ["status_code", "completed", "execution_policy", "exactness_scope", "reference_available", "output_verified", "exit_code"],
      "properties": {
        "status_code": {"enum": ["COMPLETED", "NO_FEASIBLE_PATH", "TIMEOUT", "OUT_OF_MEMORY", "LIMIT_EXCEEDED", "FUNCTION_HORIZON_EXCEEDED", "INVALID_QUERY", "INVALID_CONFIGURATION", "ERROR"]},
        "completed": {"type": "boolean"},
        "execution_policy": {"enum": ["PACE_X", "PACE_B", null]},
        "exactness_scope": {"enum": ["GLOBAL_CERTIFIED", "RETAINED_FRONTIER", "NOT_CERTIFIED"]},
        "reference_available": {"type": "boolean"},
        "output_verified": {"type": "boolean"},
        "exit_code": {"type": "integer"}
      }
    },
    "statusV3": {
      "type": "object",
      "required": ["status_code", "completed", "execution_policy", "exactness_scope", "generation_completion", "cap_triggered", "partial_output_policy", "certificate_conditions", "reference_available", "output_verified", "exit_code"],
      "properties": {
        "status_code": {"enum": ["COMPLETED", "NO_FEASIBLE_PATH", "TIMEOUT", "OUT_OF_MEMORY", "LIMIT_EXCEEDED", "FUNCTION_HORIZON_EXCEEDED", "INVALID_QUERY", "INVALID_CONFIGURATION", "ERROR"]},
        "completed": {"type": "boolean"},
        "execution_policy": {"enum": ["PACE_X", "PACE_B", null]},
        "exactness_scope": {"enum": ["GLOBAL_CERTIFIED", "RETAINED_FRONTIER", "NOT_CERTIFIED"]},
        "generation_completion": {"enum": ["COMPLETE", "NO_FEASIBLE_PATH", "RESOURCE_TRUNCATED", "ABORTED", null]},
        "cap_triggered": {"type": "array", "items": {"enum": ["CONNECTOR_M_C", "BREAKPOINT_M_B", "QUERY_WORK_M_Q", "EMERGENCY_FRONTIER_GUARD"]}},
        "partial_output_policy": {"enum": ["FAIL_CLOSED", "DETERMINISTIC_RETAINED_FRONTIER", null]},
        "certificate_conditions": {"type": "array", "items": {"type": "string"}},
        "reference_available": {"type": "boolean"},
        "output_verified": {"type": "boolean"},
        "exit_code": {"type": "integer"}
      }
    },
    "timing": {
      "type": "object",
      "required": ["preprocessing_total", "lower_bound_preprocessing", "anchor_index_preprocessing", "query_total", "cpu_total", "horizon_validation", "anchor_retrieval", "anchor_ranking", "connector_generation", "recursive_generation", "memo_lookup", "memo_compute", "temporal_stitching", "breakpoint_construction", "duplicate_removal", "safe_dominance", "bounded_retention", "fragment_merging", "feasibility_validation", "envelope_extraction", "profile_serialization", "reference_comparison"],
      "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
    },
    "memory": {
      "type": "object",
      "required": ["peak_rss", "start_rss", "end_rss", "peak_heap", "start_heap", "end_heap", "memoization_peak", "frontier_peak_estimate", "serialized_output_size"],
      "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
    },
    "counters": {
      "type": "object",
      "required": ["anchors_total", "anchors_examined", "anchors_rejected_valid_domain", "anchors_rejected_lower_bound", "anchors_retained", "connector_paths_enumerated", "connectors_rejected_lower_bound", "connectors_rejected_empty_domain", "connectors_retained", "recursive_calls", "memo_hits", "memo_misses", "memo_entries", "repeated_subproblems", "stitch_attempts", "stitch_rejected_path_consistency", "stitch_rejected_anchor_domain", "stitch_rejected_right_domain", "stitch_rejected_budget", "stitch_successes", "candidates_generated", "candidates_before_compression", "duplicate_fragments_removed", "extension_dominated_fragments_removed", "bounded_fragments_removed", "temporal_cells_created", "frontier_count", "frontier_size_sum", "frontier_size_max", "retained_fragments_total", "profile_breakpoints_total", "envelope_cells", "point_queries", "labels_created", "labels_expanded", "simple_paths_enumerated", "ksp_paths_retained", "corridor_nodes", "corridor_edges", "corridor_cells", "score_relevant_edges", "selected_pivots", "connector_calls", "connector_expansions", "valid_connectors", "invalid_connectors", "connector_cap_hits", "candidates_retained", "breakpoint_cap_hits", "total_candidate_work", "query_work_cap_hits", "frontier_cells", "peak_frontier_size", "memo_lookups", "memo_waits", "requested_workers", "observed_workers"]
    },
    "output": {
      "type": "object",
      "required": ["feasible", "feasible_interval_measure", "infeasible_interval_measure", "feasible_coverage_fraction", "elementary_envelope_cells", "final_profile_intervals", "distinct_selected_paths", "path_changes", "average_interval_length", "minimum_interval_length", "average_selected_score", "best_selected_score", "selected_departure_time", "selected_path_id", "selected_score", "selected_travel_time", "profile_checksum", "profile_file"]
    },
    "quality": {
      "type": "object",
      "required": ["path_agreement_fraction", "score_agreement_fraction", "feasibility_disagreement_fraction", "breakpoint_precision", "breakpoint_recall", "exact_breakpoint_agreement", "integrated_score_regret", "relative_score_gap_percent", "mean_absolute_score_gap", "maximum_score_gap", "p95_score_gap", "mean_travel_time_gap_on_score_ties", "missed_path_switches", "reference_profile_checksum"]
    },
    "error": {
      "type": "object",
      "required": ["type", "message", "stack_trace_or_context", "failing_phase"]
    }
  }
}
