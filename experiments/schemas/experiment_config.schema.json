{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pace.example/schemas/experiment_config.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "experiment_id", "datasets", "studies", "seeds", "workload", "protocol", "resources", "paths"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2, 3]},
    "experiment_id": {"type": "string", "minLength": 1},
    "datasets": {"type": "array", "uniqueItems": true, "items": {"enum": ["NY", "FLA", "CAL", "OL", "NY-EXACT"]}},
    "studies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "seeds": {"type": "object"},
    "workload": {
      "type": "object",
      "properties": {
        "budget_definition": {
          "const": "GRID_LOWER_BOUND_WITNESS_PATH_TRAVEL_TIME"
        }
      }
    },
    "protocol": {"type": "object"},
    "resources": {
      "type": "object",
      "required": ["timeout_seconds", "memory_limit_mb", "max_concurrent", "max_threads_per_query"],
      "properties": {
        "timeout_seconds": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "unlimited"}
          ]
        },
        "algorithm_timeout_seconds": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"const": "unlimited"}
            ]
          }
        },
        "memory_limit_mb": {"type": ["integer", "null"], "minimum": 256},
        "max_concurrent": {"type": "integer", "minimum": 1},
        "max_threads_per_query": {"type": "integer", "minimum": 1}
      }
    }
  }
}
